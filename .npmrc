; 依赖与二进制镜像（国内网络环境）
registry=https://registry.npmmirror.com/
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

; 关键：优先使用本地缓存，不逐个请求重新校验元数据。
; 在受限网络/代理环境下，元数据校验的单次往返可能被放大到数秒，
; 几百个包叠加起来会让 npm 看起来「卡死」（表现为不报错、进度为零）。
; 配合 package-lock.json 使用是安全的：版本仍由 lockfile 钉死。
prefer-offline=true

; 少两次意义不大的网络往返
audit=false
fund=false
